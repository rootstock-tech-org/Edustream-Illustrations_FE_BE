# SMART-SEG environment — template for /etc/smartseg.env
#
#   sudo cp deploy/smartseg.env /etc/smartseg.env
#   sudo chown root:root /etc/smartseg.env && sudo chmod 0640 /etc/smartseg.env
#
# This file is a template with no real values in it. Never commit a filled-in
# copy — /etc/smartseg.env is the only place the real key should exist.

# REQUIRED. Signs Flask sessions and Socket.IO payloads. Without it the app falls
# back to a published development key, which is not a secret.
#   openssl rand -hex 32
SMARTSEG_SECRET_KEY=replace-me

# REQUIRED in any deployment others can reach. Origins allowed to open a
# Socket.IO connection; comma-separated for more than one. Leaving it unset means
# "*", which lets any site drive your dashboard's controls.
SMARTSEG_CORS_ORIGINS=https://smartseg.example.com

# MOCK is the only mode that runs without an Intel RealSense camera attached.
SMARTSEG_SENSOR_MODE=MOCK

# Bind address for gunicorn is set in the unit file; this is what the app reports
# and what the healthcheck probes.
SMARTSEG_PORT=5000

# The simulation loop is CPU-bound and saturates roughly one core at 30 Hz,
# connected browsers or not. Dropping to 15 measured ~82% of a core against
# ~103% at 30 Hz — worth having on a small instance, but note it buys about 20%
# rather than half, because the sensor imagery renders on its own 10 Hz timer.
# SMARTSEG_TICK_RATE_HZ=30
# SMARTSEG_EMIT_RATE_HZ=30
